{
  "name": "@anywear/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "audit": "pnpm audit --audit-level high",
    "check": "node scripts/check-compatibility.mjs && eslint . --max-warnings=0 && tsc --noEmit && playwright test --list",
    "compatibility:check": "node scripts/check-compatibility.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:full-stack": "playwright test --grep @full-stack",
    "test:list": "playwright test --list",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1097.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "~24.12.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
