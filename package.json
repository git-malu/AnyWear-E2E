{
  "name": "@anywear/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "audit": "pnpm audit --audit-level high",
    "check": "node scripts/check-compatibility.mjs && node --test scripts/*.test.mjs && eslint . --max-warnings=0 && tsc --noEmit && playwright test --list",
    "compatibility:check": "node scripts/check-compatibility.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:full-stack": "playwright test --grep @full-stack",
    "accounts:cleanup-workers": "node scripts/cleanup-worker-accounts.mjs",
    "test:list": "playwright test --list",
    "qualification:collect": "node scripts/collect-deployment-evidence.mjs",
    "qualification:generate": "node scripts/create-qualification-record.mjs",
    "qualification:verify": "node scripts/verify-qualification-record.mjs",
    "runtime:plan": "node scripts/runtime-drill.mjs --plan",
    "runtime:preflight": "node scripts/runtime-drill.mjs --preflight",
    "runtime:verify": "node scripts/runtime-drill.mjs --verify",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@actions/artifact": "^6.2.1",
    "@aws-sdk/client-cognito-identity-provider": "^3.1097.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-sts": "^3.1146.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "~24.12.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
