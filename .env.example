# AWS_PROFILE=your-authorized-nonprod-profile
AWS_REGION=ap-east-1
E2E_STAGE=beta
E2E_EXTERNAL_SERVERS=true
E2E_CLIENT_URL=https://client.beta.example
E2E_SERVICE_URL=https://api.beta.example
USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Issue 86 per-test direct teardown. The run scope must match
# <run id>-<attempt>-<16 hex chars>; CLEANUP_MACHINE_AUTH_SECRET signs the
# short-lived, capability-scoped machine requests to /cleanup-operations.
E2E_CLEANUP_RUN_SCOPE=
CLEANUP_MACHINE_AUTH_SECRET=
E2E_MACHINE_CALLER_ID=anywear-e2e-suite
